{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        org.clojure/tools.namespace {:mvn/version "1.5.0"}

        ; closed-record for type-safe maps
        closed-record/closed-record {:local/root "../closed-record"}

        ; swing-fx library (local)
        swing-fx/swing-fx {:local/root "./swing-fx"}

        ; Seesaw for declarative Swing (transitively via swing-fx)
        seesaw/seesaw {:mvn/version "1.5.0"}

        ; GraphStream for graph visualization
        org.graphstream/gs-core {:mvn/version "2.0"}
        org.graphstream/gs-ui-swing {:mvn/version "2.0"}

        ; Apache Batik for SVG rendering
        org.apache.xmlgraphics/batik-swing {:mvn/version "1.17"}
        org.apache.xmlgraphics/batik-codec {:mvn/version "1.17"}
        org.apache.xmlgraphics/batik-transcoder {:mvn/version "1.17"}

        ; Logging
        genek/logging {:local/root "../logging"}
        com.taoensso/timbre {:mvn/version "6.6.1"}

        ; Reveal for REPL debugging
        vlaaad/reveal {:mvn/version "1.3.280"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {}}

  :test {:extra-paths ["test"]
         :extra-deps {}}

  :run-tests {:extra-paths ["test"]
              :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
              :main-opts ["-m" "kaocha.runner"]
              :jvm-opts ["-Djava.awt.headless=true"]}

  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          ;; this allows nrepl to interrupt runaway repl evals
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline"]}}}
